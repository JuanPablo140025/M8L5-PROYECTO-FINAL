### Variables
# Cambia el '#' de lugar según dónde quieras probar (Local o Render)
@host = https://m8l5-proyecto-final.onrender.com
# @host = http://localhost:3000

@token = TU_TOKEN_JWT_AQUI

### 1. Chequeo de Salud
GET {{host}}/salud

### 2. Registro de Usuario Normal
POST {{host}}/auth/registro
Content-Type: application/json

{
  "nombre": "Crash Bandicoot",
  "email": "crash@wumpa.com",
  "password": "Password123!"
}

### 3. Login de Usuario
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "jugador@retroquest.com",
  "password": "AdminPass123!"
}

### 4. Obtener mis juegos
GET {{host}}/juegos
Authorization: Bearer {{token}}

### 5. Crear juego
POST {{host}}/juegos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titulo": "Metroid Prime",
  "plataforma": "GameCube",
  "estado": "Jugando",
  "horas_jugadas": 5,
  "rating": 5
}

### 6. Actualizar juego (Reemplaza el '1' por el ID de tu juego)
PUT {{host}}/juegos/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "Completado",
  "horas_jugadas": 15,
  "rating": 5
}

### 7. Eliminar juego (Reemplaza el '1' por el ID de tu juego)
DELETE {{host}}/juegos/1
Authorization: Bearer {{token}}

### 8. Ruta Admin
GET {{host}}/admin/estadisticas
Authorization: Bearer {{token}}


# ========================================================
# PRUEBAS DE SEGURIDAD QUE DEBEN FALLAR (OBLIGATORIAS)
# ========================================================

### Caso Falla 1: Inyección SQL (Debe ser bloqueado)
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "admin@retroquest.com' OR '1'='1",
  "password": "password"
}

### Caso Falla 2: Sin Token (Debe responder 401 Unauthorized)
GET {{host}}/juegos

### Caso Falla 3: Input Inválido (Debe responder 400 Bad Request)
POST {{host}}/juegos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "horas_jugadas": 10
}